# Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/elite_mind_construction
MONGODB_DATABASE=elite_mind_construction

# API
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Email (SMTP)
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Security
JWT_SECRET=
